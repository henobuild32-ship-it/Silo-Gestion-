NEXT_PUBLIC_SUPABASE_URL=https://llwzdaqsdfcltqkncjhl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Compatible legacy: utiliser NEXT_PUBLIC_SUPABASE_ANON_KEY à la place si nécessaire.
# Serveur uniquement — Supabase secret key (ou legacy service_role). Jamais NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your_server_only_secret_key
# Clé aléatoire à créer avant le premier déploiement. Elle est requise une seule fois pour créer l'administrateur principal.
INITIAL_ADMIN_SETUP_KEY=generate-a-long-random-secret
# URL publique de l'application, utilisée dans les liens de partage.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Web Push: generate avec web-push generate-vapid-keys. Clé privée uniquement serveur.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
# Mailto de l’administrateur ou URL HTTPS de production.
VAPID_SUBJECT=mailto:admin@example.com
# SMTP Gmail — requis uniquement pour les codes de confirmation des réunions.
# Utiliser un mot de passe d'application Gmail (avec validation en deux étapes), jamais le mot de passe Gmail habituel.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME="Silo Vert"
# Secret aléatoire serveur d'au moins 32 caractères, distinct des autres secrets.
ATTENDANCE_OTP_SECRET=
